# ==========================================================
# ISSUE #2: EXPLORATORY DATA ANALYSIS (EDA) & CYTOLOGICAL MAPPING
# Zero-Auth Direct Download via KaggleHub Public Mirror (No Google Pop-ups!)
# ==========================================================

import os
import cv2
import kagglehub
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
from sklearn.manifold import TSNE

# ----------------------------------------------------------
# 0. Download Dataset Directly (Zero Google Auth / Zero 403 Errors)
# ----------------------------------------------------------
# Clean up the 0-byte dummy file from the failed curl attempt
if os.path.exists('/content/PBC_dataset_normal_DIB.zip') and os.path.getsize('/content/PBC_dataset_normal_DIB.zip') < 1000000:
    os.remove('/content/PBC_dataset_normal_DIB.zip')

print("Downloading PBC_dataset_normal_DIB (17,092 images) directly via kagglehub...")
download_root = kagglehub.dataset_download("unclesamulus/blood-cells-image-dataset")
print(f"Downloaded to: {download_root}")

target_classes = {'basophil', 'eosinophil', 'erythroblast', 'ig', 'lymphocyte', 'monocyte', 'neutrophil', 'platelet'}
dataset_path = None

for root, dirs, _ in os.walk(download_root):
    if len(target_classes.intersection({d.lower() for d in dirs})) >= 4:
        dataset_path = root
        break

print(f"Verified dataset directory: {dataset_path}")

# ----------------------------------------------------------
# 1. Directory & Integrity Mapping
# ----------------------------------------------------------
valid_extensions = ('.jpg', '.jpeg', '.png', '.bmp', '.tif', '.tiff')
class_counts = {}
class_files = {}
corrupt_files = 0

for folder_name in sorted(os.listdir(dataset_path)):
    folder_path = os.path.join(dataset_path, folder_name)
    if os.path.isdir(folder_path) and not folder_name.startswith('.'):
        valid_imgs = []
        for file in os.listdir(folder_path):
            if file.lower().endswith(valid_extensions) and not file.startswith('.'):
                file_path = os.path.join(folder_path, file)
                if os.path.getsize(file_path) > 0:
                    valid_imgs.append(file_path)
                else:
                    corrupt_files += 1
        if len(valid_imgs) > 0:
            class_counts[folder_name] = len(valid_imgs)
            class_files[folder_name] = valid_imgs

total_images = sum(class_counts.values())
print(f"\nTotal Valid Images: {total_images} | Corrupted/Zero-Byte Files: {corrupt_files}")

df_dist = pd.DataFrame(list(class_counts.items()), columns=['Cell Class', 'Count'])
df_dist = df_dist.sort_values(by='Count', ascending=False).reset_index(drop=True)
min_count = df_dist['Count'].min()
df_dist['Percentage (%)'] = (df_dist['Count'] / total_images * 100).round(2)
df_dist['Imbalance Ratio'] = (df_dist['Count'] / min_count).round(2)
display(df_dist)

# ----------------------------------------------------------
# 2. Class Imbalance Assessment (Bar Chart)
# ----------------------------------------------------------
plt.figure(figsize=(10, 5))
ax = sns.barplot(data=df_dist, x='Cell Class', y='Count', hue='Cell Class', palette='viridis', legend=False)
plt.title('Peripheral Blood Cell Class Distribution & Imbalance', fontsize=14)
plt.xlabel('Cell Lineage', fontsize=12)
plt.ylabel('Number of Images', fontsize=12)
plt.xticks(rotation=30)
for p in ax.patches:
    ax.annotate(f'{int(p.get_height())}', (p.get_x() + p.get_width() / 2., p.get_height()),
                ha='center', va='bottom', fontsize=10, fontweight='bold')
plt.tight_layout()
plt.show()

# ----------------------------------------------------------
# 3. Visual & Chromatic Profiling (3x3 Grid & RGB KDE)
# ----------------------------------------------------------
fig, axes = plt.subplots(3, 3, figsize=(10, 10))
fig.suptitle('3x3 Class Representative Grid (360x360 Raw Microscopy)', fontsize=15)

classes_list = df_dist['Cell Class'].tolist()
for i, ax in enumerate(axes.flat):
    if i < len(classes_list):
        cls_name = classes_list[i]
        img_rgb = cv2.cvtColor(cv2.imread(class_files[cls_name][0]), cv2.COLOR_BGR2RGB)
        ax.imshow(img_rgb)
        ax.set_title(f"{cls_name.upper()} ({img_rgb.shape[1]}x{img_rgb.shape[0]})", fontsize=11, fontweight='bold')
    ax.axis('off')
plt.tight_layout()
plt.show()

plt.figure(figsize=(10, 5))
r_vals, g_vals, b_vals = [], [], []
for cls_name, files in class_files.items():
    for fpath in files[:15]:
        img_rgb = cv2.cvtColor(cv2.imread(fpath), cv2.COLOR_BGR2RGB)
        img_small = cv2.resize(img_rgb, (64, 64))
        r_vals.append(img_small[:, :, 0].flatten())
        g_vals.append(img_small[:, :, 1].flatten())
        b_vals.append(img_small[:, :, 2].flatten())

sns.kdeplot(np.concatenate(r_vals), color='red', label='Red Channel', fill=True, alpha=0.2)
sns.kdeplot(np.concatenate(g_vals), color='green', label='Green Channel', fill=True, alpha=0.2)
sns.kdeplot(np.concatenate(b_vals), color='blue', label='Blue Channel', fill=True, alpha=0.2)
plt.title('RGB Pixel Intensity KDE Distribution (Wright-Giemsa Stain Profile)', fontsize=14)
plt.xlabel('Pixel Intensity (0-255)', fontsize=12)
plt.ylabel('Density', fontsize=12)
plt.xlim(0, 255)
plt.legend()
plt.tight_layout()
plt.show()

# ----------------------------------------------------------
# 4. Dimensionality Reduction (t-SNE on Flattened Embeddings)
# ----------------------------------------------------------
print("\n--- 4. Computing t-SNE Embeddings (takes ~30 seconds) ---")
X_flat, y_labels = [], []
for cls_name, files in class_files.items():
    for fpath in files[:80]:
        img_rgb = cv2.cvtColor(cv2.imread(fpath), cv2.COLOR_BGR2RGB)
        img_resized = cv2.resize(img_rgb, (48, 48))
        X_flat.append(img_resized.flatten())
        y_labels.append(cls_name)

X_flat = np.array(X_flat, dtype=np.float32) / 255.0
X_tsne = TSNE(n_components=2, random_state=42, perplexity=30).fit_transform(X_flat)

plt.figure(figsize=(10, 7))
sns.scatterplot(x=X_tsne[:, 0], y=X_tsne[:, 1], hue=y_labels, palette='tab10', s=65, alpha=0.85)
plt.title('t-SNE Projection of Raw Flattened Blood Cell Images', fontsize=14)
plt.xlabel('t-SNE Dimension 1', fontsize=12)
plt.ylabel('t-SNE Dimension 2', fontsize=12)
plt.legend(bbox_to_anchor=(1.02, 1), loc='upper left', title='Cell Lineage')
plt.tight_layout()
plt.show()
