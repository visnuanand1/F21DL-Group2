import os
import glob
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
import tensorflow as tf
from tensorflow.keras import layers, models
from sklearn.metrics import classification_report, confusion_matrix

# 1. Setup Parameters
IMG_SIZE = (128, 128)
BATCH_SIZE = 32
SEED = 42

# Safely resolve data directory
try:
    _data_dir = data_dir
except NameError:
    _data_dir = './extracted_cells/PBC_dataset_normal_DIB'

# 2. Build Dataset Lists
valid_exts = ('*.jpg', '*.jpeg', '*.png', '*.bmp')
image_paths = []
labels = []

if os.path.exists(_data_dir):
    for class_name in sorted(os.listdir(_data_dir)):
        class_path = os.path.join(_data_dir, class_name)
        if os.path.isdir(class_path):
            files = []
            for ext in valid_exts:
                files.extend(glob.glob(os.path.join(class_path, ext)))
                files.extend(glob.glob(os.path.join(class_path, ext.upper())))
            if files:
                image_paths.extend(files)
                labels.extend([class_name] * len(files))

df_full = pd.DataFrame({'image_path': image_paths, 'label': labels})
class_names = sorted(df_full['label'].unique())
num_classes = len(class_names)

# 3. Stratified 80/20 Train/Validation Split
train_dfs = []
val_dfs = []
for cls in class_names:
    cls_df = df_full[df_full['label'] == cls].sample(frac=1, random_state=SEED)
    split_idx = int(len(cls_df) * 0.8)
    train_dfs.append(cls_df.iloc[:split_idx])
    val_dfs.append(cls_df.iloc[split_idx:])

train_df_full = pd.concat(train_dfs).sample(frac=1, random_state=SEED).reset_index(drop=True)
val_df_full = pd.concat(val_dfs).sample(frac=1, random_state=SEED).reset_index(drop=True)

print(f"--- Full Dataset Splits ---")
print(f"Training images: {len(train_df_full)}")
print(f"Validation images: {len(val_df_full)}")

# 4. Pipelines
def preprocess_img(path, label_name):
    img_raw = tf.io.read_file(path)
    img_tensor = tf.image.decode_image(img_raw, channels=3, expand_animations=False)
    img_tensor = tf.image.resize(img_tensor, IMG_SIZE)
    label_idx = tf.lookup.StaticHashTable(
        tf.lookup.KeyValueTensorInitializer(class_names, list(range(num_classes))),
        default_value=-1
    ).lookup(label_name)
    return img_tensor, label_idx

train_ds_full = tf.data.Dataset.from_tensor_slices((train_df_full['image_path'].values, train_df_full['label'].values))
train_ds_full = train_ds_full.map(preprocess_img, num_parallel_calls=tf.data.AUTOTUNE)

val_ds_full = tf.data.Dataset.from_tensor_slices((val_df_full['image_path'].values, val_df_full['label'].values))
val_ds_full = val_ds_full.map(preprocess_img, num_parallel_calls=tf.data.AUTOTUNE)

data_augmentation = tf.keras.Sequential([
    layers.RandomFlip("horizontal_and_vertical"),
    layers.RandomRotation(0.2),
    layers.RandomZoom(0.1),
])

AUTOTUNE = tf.data.AUTOTUNE
train_ds_full = train_ds_full.cache().shuffle(1000).batch(BATCH_SIZE).prefetch(buffer_size=AUTOTUNE)
val_ds_full = val_ds_full.cache().batch(BATCH_SIZE).prefetch(buffer_size=AUTOTUNE)

# 5. Build Model 2 Architecture with GAP
model_full_gap = models.Sequential([
    layers.Input(shape=(IMG_SIZE[0], IMG_SIZE[1], 3)),
    layers.Rescaling(1./255),
    data_augmentation,

    layers.Conv2D(32, (3, 3), padding='same'),
    layers.BatchNormalization(),
    layers.Activation('relu'),
    layers.MaxPooling2D((2, 2)),

    layers.Conv2D(64, (3, 3), padding='same'),
    layers.BatchNormalization(),
    layers.Activation('relu'),
    layers.MaxPooling2D((2, 2)),

    layers.Conv2D(128, (3, 3), padding='same'),
    layers.BatchNormalization(),
    layers.Activation('relu'),
    layers.MaxPooling2D((2, 2)),

    layers.Conv2D(256, (3, 3), padding='same'),
    layers.BatchNormalization(),
    layers.Activation('relu'),
    layers.MaxPooling2D((2, 2)),

    layers.GlobalAveragePooling2D(),
    layers.Dense(256, activation='relu'),
    layers.BatchNormalization(),
    layers.Dropout(0.5),
    layers.Dense(num_classes, activation='softmax')
])

model_full_gap.compile(
    optimizer=tf.keras.optimizers.Adam(learning_rate=1e-3),
    loss=tf.keras.losses.SparseCategoricalCrossentropy(),
    metrics=['accuracy']
)

callbacks = [
    tf.keras.callbacks.ReduceLROnPlateau(monitor='val_loss', factor=0.5, patience=3, min_lr=1e-6, verbose=1),
    tf.keras.callbacks.EarlyStopping(monitor='val_loss', patience=10, restore_best_weights=True, verbose=1)
]

# 6. Train with 50 Epochs
history_full_gap = model_full_gap.fit(train_ds_full, validation_data=val_ds_full, epochs=50, callbacks=callbacks)

# 7. Visualization: Loss & Accuracy Plots
fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(16, 5))
ax1.plot(history_full_gap.history['accuracy'], label='Train Acc', color='teal')
ax1.plot(history_full_gap.history['val_accuracy'], label='Val Acc', color='orange', linestyle='--')
ax1.set_title('Training & Validation Accuracy (GAP - 50 Epochs)')
ax1.set_xlabel('Epoch')
ax1.set_ylabel('Accuracy')
ax1.legend()
ax1.grid(True)

ax2.plot(history_full_gap.history['loss'], label='Train Loss', color='teal')
ax2.plot(history_full_gap.history['val_loss'], label='Val Loss', color='orange', linestyle='--')
ax2.set_title('Training & Validation Loss (GAP - 50 Epochs)')
ax2.set_xlabel('Epoch')
ax2.set_ylabel('Loss')
ax2.legend()
ax2.grid(True)
plt.show()

# 8. Evaluation: Predictions & Confusion Matrix
y_true, y_pred = [], []
for images, labels_batch in val_ds_full:
    preds = model_full_gap.predict(images, verbose=0)
    y_true.extend(labels_batch.numpy())
    y_pred.extend(np.argmax(preds, axis=1))

y_true = np.array(y_true)
y_pred = np.array(y_pred)

plt.figure(figsize=(10, 8))
cm = confusion_matrix(y_true, y_pred)
sns.heatmap(cm, annot=True, fmt='d', cmap='Blues', xticklabels=class_names, yticklabels=class_names)
plt.title('Confusion Matrix: Model 2 with GAP (Full Dataset - 50 Epochs)')
plt.xlabel('Predicted Label')
plt.ylabel('True Label')
plt.tight_layout()
plt.show()

print("=" * 65)
print("       MODEL 2 WITH GAP FULL DATASET CLASSIFICATION REPORT")
print("=" * 65)
print(classification_report(y_true, y_pred, target_names=class_names, zero_division=0))
